# --- Discord : choisis UN des deux modes ---
# Mode simple (par défaut) : webhook. Suffisant pour recevoir les alertes.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# Mode bot (optionnel) : débloque les boutons "Acheter" et prépare l'autobuy.
# Si ces DEUX lignes sont remplies, le bot est utilisé à la place du webhook.
DISCORD_BOT_TOKEN=
# Routage optionnel par enseigne (sinon webhook/salon par defaut) :
# DISCORD_WEBHOOKS_BY_STORE=Auchan=https://discord.com/api/webhooks/...,Leclerc=...
# DISCORD_CHANNELS_BY_STORE=Auchan=123456789,Leclerc=987654321
DISCORD_CHANNEL_ID=
# Rôle à mentionner sur une alerte stock (notif instantanée). Vide = pas de ping.
DISCORD_ALERT_ROLE_ID=

DB_PATH=tcg_stocks.db
LOG_LEVEL=INFO
MIN_SLEEP=60
MAX_SLEEP=180
USE_GEMINI_FILTER=false
REQUEST_TIMEOUT_MS=30000
RUN_ONCE=false

# Fenêtre anti-doublon des alertes (secondes). 600 = 10 min.
ALERT_DEDUP_WINDOW=600

# Résumé "heartbeat" périodique sur Discord (secondes). 86400 = 1x/jour. 0 = off.
HEARTBEAT_INTERVAL=86400

# Mise en veille auto d'une enseigne après N échecs consécutifs, pendant X secondes.
STORE_PAUSE_THRESHOLD=3
STORE_PAUSE_DURATION=3600

# Alerte "baisse de prix" : seuil de baisse en % (sur un produit en stock). 0 = off.
DEAL_DROP_PERCENT=15

# Masquer les revendeurs tiers (marketplace Leclerc/Auchan). true = ne garder que
# les vendeurs officiels (enseigne + boutiques). false = tout alerter, avec une
# pastille ✅ (officiel) / 🔁 (revendeur) dans chaque alerte.
MASQUER_REVENDEURS=false

# Rétention de l'historique de prix (jours). Purgé au démarrage au-delà.
HISTORY_RETENTION_DAYS=90

# --- Filet de secours "scraping API" (optionnel, payant au-delà du free tier) ---
# Utilisé UNIQUEMENT quand une requête directe est bloquée (ex. DataDome/Leclerc).
# On essaie les fournisseurs renseignés EN CASCADE (cumul des quotas gratuits).
# Laisse vide = 100% gratuit (aucun proxy). PROXY_FALLBACK=false pour désactiver
# même si des clés sont présentes.
SCRAPINGBEE_KEY=
ZENROWS_KEY=
CRAWLBASE_TOKEN=
#PROXY_FALLBACK=true

# Enseignes surveillées (séparées par virgules). Par défaut : les rapides et fiables
# (2 grands magasins + 2 boutiques Shopify + 1 boutique WooCommerce, toutes FR).
# Pour tenter un site blindé : ENABLED_STORES=Auchan,Leclerc,...,Cultura
ENABLED_STORES=Auchan,Leclerc,Carrefour,LudiJeux,RelicTCG,CoinBarons,Dracaugames

# Boutiques Shopify à surveiller (un seul scraper générique les gère toutes).
# Format: Nom=domaine. Laisse vide pour le défaut (LudiJeux, RelicTCG, Dracaugames).
# Pense à ajouter le Nom dans ENABLED_STORES aussi.
#SHOPIFY_SHOPS=LudiJeux=ludijeux.fr,RelicTCG=relictcg.com,Dracaugames=dracaugames.com
# Boutiques decouvertes par catalogue complet (/products.json : ruptures incluses) :
#SHOPIFY_CATALOGUE_COMPLET=Dracaugames

# Carrefour : compter aussi le stock des marchands tiers (marketplace) ? Defaut : non.
#CARREFOUR_INCLURE_MARKETPLACE=false

# Boutiques WooCommerce à surveiller (Store API publique). Même principe.
# Défaut : CoinBarons (Le Coin des Barons).
#WOO_SHOPS=CoinBarons=lecoindesbarons.com

# Cadence & anti faux restock (valeurs par defaut)
MIN_CYCLE_GAP=5
RUPTURE_CONFIRMATIONS=2

# --- Performances des boutiques Shopify / WooCommerce (C8B) ---
# Lecture groupee de la watchlist (catalogue au lieu d'une requete par fiche). Defaut : true.
#WATCHLIST_LOT=true
# Decouverte par collections Shopify (ruptures incluses, bien plus complete que la recherche) :
#SHOPIFY_CATALOGUE_COMPLET=Dracaugames,LudiJeux,RelicTCG
# Collections a lire (sinon detection automatique) : Nom=handle1|handle2,Autre=h
#SHOPIFY_COLLECTIONS=
# Variantes ignorees pour le stock (etat / langue non voulus) :
#SHOPIFY_VARIANTES_EXCLUES=endommag,abim,occasion,used,damaged,anglais,english,japonais
# Baisse de prix : lectures identiques consecutives avant alerte (1 = immediat).
#PRIX_CONFIRMATIONS=2
# Produit introuvable : constats consecutifs, heures d'absence continue, intervalle de relecture.
#DISPARU_MIN_ECHECS=5
#DISPARU_APRES_HEURES=6
#DISPARU_RECHECK_HEURES=6
